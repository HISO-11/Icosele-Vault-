terraform {
  required_providers {
    icosele_vm = {
      source  = "icosele/icosele-vm"
      version = "~> 0.1"
    }
  }
}

variable "icosele_api_key" {
  type      = string
  sensitive = true
}

provider "icosele_vm" {
  api_key = var.icosele_api_key
  host    = "localhost"
  port    = 47820
}

resource "icosele_vm_vm" "dev_machine" {
  name      = "development"
  ram_mb    = 8192
  cpu_cores = 4
  disk_gb   = 100
  os_type   = "linux"
}

resource "icosele_vm_snapshot" "pre_deploy" {
  vm_id = icosele_vm_vm.dev_machine.id
  name  = "pre-deployment"
  tag   = "terraform-managed"
}

resource "icosele_vm_network_policy" "dev_firewall" {
  vm_id = icosele_vm_vm.dev_machine.id
  rules = [
    {
      direction = "in"
      protocol  = "tcp"
      port      = "22"
      action    = "allow"
    },
    {
      direction = "out"
      protocol  = "any"
      action    = "allow"
    }
  ]
}
