{
  "name": "icosele-vm",
  "displayName": "Icosele VM",
  "description": "Control Icosele VM VMs from VSCode",
  "version": "0.1.0",
  "publisher": "icosele",
  "engines": { "vscode": "^1.80.0" },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      { "command": "icosele-vm.listVMs", "title": "Icosele VM: List VMs" },
      { "command": "icosele-vm.startVM", "title": "Icosele VM: Start VM" },
      { "command": "icosele-vm.stopVM", "title": "Icosele VM: Stop VM" },
      { "command": "icosele-vm.takeSnapshot", "title": "Icosele VM: Take Snapshot" },
      { "command": "icosele-vm.openDashboard", "title": "Icosele VM: Open Dashboard" },
      { "command": "icosele-vm.status", "title": "Icosele VM: Show Status" }
    ]
  }
}
